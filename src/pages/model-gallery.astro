---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/mouse-study.css";
---

<SiteLayout title="统一模型检查" description="统一查看桌面候选模型的结构、材质、视角与渲染统计。" theme="soft" immersive>
  <section class="mouse-study model-gallery" data-model-gallery-root aria-label="统一模型检查页">
    <header class="mouse-study__header">
      <a class="mouse-study__link" href="/?desktop=refined">整桌候选</a>
      <div class="mouse-study__title"><p>Eryu</p><h1>统一模型检查</h1></div>
      <a class="mouse-study__link" href="/">原版对照</a>
    </header>

    <div class="mouse-study__viewer">
      <div class="mouse-study__canvas" data-gallery-canvas aria-label="拖动旋转模型，滚轮缩放"></div>
      <div class="mouse-study__loading" data-gallery-loading role="status"><span></span><p data-gallery-loading-text>正在准备机箱</p></div>
      <div class="mouse-study__error" data-gallery-error hidden role="status">
        <h2>三维预览未能启动</h2>
        <p data-gallery-error-message>模型检查器还在准备中，或当前浏览器未能启动 WebGL。</p>
        <button type="button" data-gallery-retry>重试</button>
      </div>
    </div>

    <aside class="mouse-study__panel" aria-label="模型检查控制台">
      <section class="mouse-study__controls" aria-label="物件">
        <p class="mouse-study__label">物件</p>
        <select class="model-gallery__select" data-gallery-select aria-label="选择物件"></select>
      </section>

      <section class="mouse-study__controls" aria-label="视角">
        <p class="mouse-study__label">视角</p>
        <div class="mouse-study__button-row">
          <button type="button" data-camera-preset="angled">斜侧</button>
          <button type="button" data-camera-preset="front">正面</button>
          <button type="button" data-camera-preset="side">侧面</button>
          <button type="button" data-camera-preset="back">背面</button>
          <button type="button" data-camera-preset="top">俯视</button>
        </div>
        <p class="mouse-study__note">拖动旋转，滚轮缩放；静止时不持续渲染。</p>
      </section>

      <section class="mouse-study__controls" aria-label="显示模式">
        <p class="mouse-study__label">显示模式</p>
        <div class="mouse-study__segmented" role="group" aria-label="切换材质或素模">
          <button type="button" data-shading-mode="material">材质</button>
          <button type="button" data-shading-mode="clay">素模</button>
        </div>
      </section>

      <section class="mouse-study__stats" aria-label="样件统计">
        <p class="mouse-study__label">结构统计</p>
        <dl>
          <div><dt>三角面</dt><dd data-stat="triangles">-</dd></div>
          <div><dt>材质数</dt><dd data-stat="materials">-</dd></div>
          <div><dt>绘制调用</dt><dd data-stat="calls">-</dd></div>
        </dl>
        <p class="mouse-study__note">三角面包含 InstancedMesh 数量；绘制调用来自 renderer.info。</p>
      </section>

      <p class="mouse-study__note" data-gallery-status role="status">隐藏结构为合理近似。</p>
    </aside>
  </section>

  <style>
    .model-gallery { height: 100vh; min-height: 760px; }
    .model-gallery .mouse-study__viewer { min-height: 0; }
    .model-gallery .mouse-study__button-row { grid-template-columns: 1fr 1fr; }
    .model-gallery .mouse-study__button-row button:last-child { grid-column: 1 / -1; }
    .model-gallery__select {
      width: 100%;
      min-height: 40px;
      border: 1px solid #c9ccc3;
      border-radius: 7px;
      padding: 0 10px;
      color: #252622;
      background: #f8f8f5;
      font: inherit;
    }
  </style>

  <script>
    import { mountModelGallery } from "../desktop/studies/model-gallery";

    const root = document.querySelector<HTMLElement>("[data-model-gallery-root]");
    const dispose = root ? mountModelGallery(root) : undefined;
    const cleanup = () => {
      window.removeEventListener("pagehide", cleanup);
      dispose?.();
    };
    window.addEventListener("pagehide", cleanup, { once: true });
    import.meta.hot?.dispose(cleanup);
  </script>
</SiteLayout>
