eryu.fun, www.eryu.fun {
    root * /srv/eryu-homepage
    encode zstd gzip

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        X-Frame-Options SAMEORIGIN
    }

    file_server

    handle_errors {
        rewrite * /404.html
        file_server
    }
}
