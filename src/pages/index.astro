---
import HomeLayout from "../layouts/HomeLayout.astro";
import HomeTopbar from "../components/HomeTopbar.astro";
import { allFootprints, type Kind } from "../data/footprints";

const kindLabel: Record<Kind, string> = {
  attend: "参加",
  compete: "参赛",
  volunteer: "志愿者",
  share: "分享",
};

const highlights: { date: string; title: string; kind: Kind; award?: string; thumb?: string; dense?: boolean }[] = [
  { date: "2025.02", title: "飞桨开发者沙龙", kind: "attend" },
  { date: "2025.08", title: "书生实战营 论文微调", kind: "compete", award: "二等奖" },
  { date: "2025.12", title: "模法黑客松 S1 金融赛道", kind: "compete", award: "三等奖" },
  { date: "2026.01", title: "AI 切磋大会", kind: "volunteer" },
  { date: "2026.03", title: "高校黑客松 入选决赛", kind: "compete" },
  { date: "2026.04", title: "杭州 2050 大会", kind: "share", thumb: "/home/thumb-2050.webp" },
  { date: "2026.05–08", title: "WaytoAGI、Nova 5 场分享", kind: "share", thumb: "/home/thumb-b.webp", dense: true },
  { date: "2026.09", title: "YOLO Vision 深圳 展位", kind: "compete" },
  { date: "2026.10", title: "WaytoAGI 南京站 查个底", kind: "compete", award: "优秀奖" },
  { date: "2026.10", title: "Nova AI Club 团队", kind: "share" },
];

const total = allFootprints.length;
const shares = 6;
const awards = allFootprints.filter((f) => f.award).length;
---

<HomeLayout
  title="尔玉 | AI玩尔玉"
  description="我是尔玉，把有意思的想法做成能跑起来的东西。Nova AI Club 分享人、杭州 2050 大会分享者、FSHD 早筛项目开发者。"
>
  <div class="page">
    <HomeTopbar current="home" />

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <h1 id="hero-title"><span class="mark">我是尔玉</span></h1>
        <p class="lead">把有意思的想法，<br /><span class="mark">做成能跑起来的东西</span></p>
        <ul class="tags">
          <li>Nova AI Club<br />分享人</li>
          <li>杭州 2050 大会<br />分享者</li>
          <li>FSHD 早筛项目<br />开发者</li>
        </ul>

        <figure class="photo">
          <img src="/home/talk-2050.webp" width="1000" height="1250" alt="尔玉在杭州 2050 大会上分享 FSHD 面部早筛" />
          <figcaption class="note note-pin">2050 大会<br />2026.04</figcaption>
        </figure>

        <dl class="stats">
          <div><dt>场线下活动</dt><dd><span class="mark">{total}</span></dd></div>
          <div><dt>场分享</dt><dd><span class="mark">{shares}</span></dd></div>
          <div><dt>次获奖</dt><dd><span class="mark">{awards}</span></dd></div>
        </dl>

        <a class="scroll-hint" href="#footprint">往下看看我做过什么 ↓</a>
      </section>

      <section class="footprint" id="footprint" aria-labelledby="footprint-title">
        <div class="fp-side">
          <div class="section-head">
            <p class="eyebrow">No.02 活动足迹</p>
            <h2 id="footprint-title">两年，<br /><span class="mark">从台下到台上</span></h2>
          </div>
          <p class="fp-intro">两年里参加了 {total} 场线下活动：从台下听，到参赛、做志愿者，再到上台分享。</p>
          <ul class="legend" aria-label="图例">
            {(Object.keys(kindLabel) as Kind[]).map((k) => (
              <li><i class={`dot ${k}`}></i>{kindLabel[k]}</li>
            ))}
          </ul>
          <p class="note note-pin note-side">从听众变成<br />讲的人</p>
        </div>

        <div class="fp-main">
        <ol class="timeline">
          {highlights.map((h) => (
            <li class:list={[{ dense: h.dense, "has-thumb": h.thumb }]}>
              <time>{h.date}</time>
              <i class={`dot ${h.kind}`} aria-label={kindLabel[h.kind]}></i>
              <span class="title">{h.title}{h.award && <span class="stamp">{h.award}</span>}</span>
              {h.thumb && <img class="thumb" src={h.thumb} width="180" height="128" alt="" loading="lazy" />}
            </li>
          ))}
        </ol>

        <details class="all">
          <summary>看全部 {total} 场 <span aria-hidden="true">→</span></summary>
          <ol class="timeline compact">
            {allFootprints.map((f) => (
              <li>
                <time>{f.date}</time>
                <i class={`dot ${f.kind}`} aria-label={kindLabel[f.kind]}></i>
                <span class="title">{f.title}{f.award && <span class="stamp">{f.award}</span>}</span>
              </li>
            ))}
          </ol>
        </details>
        </div>
      </section>
    </main>
  </div>

</HomeLayout>
