---
import SiteLayout from "../layouts/SiteLayout.astro";
import "../styles/mouse-study.css";
---

<SiteLayout title="键盘样件查看" description="独立查看 Eryu 全尺寸键盘样件的键位、外壳与材质比例。" theme="soft" immersive>
  <section class="mouse-study keyboard-study" data-keyboard-study-root aria-label="Eryu 键盘样件查看页">
    <header class="mouse-study__header">
      <a class="mouse-study__link" href="/">返回原主页</a>
      <div class="mouse-study__title"><p>Eryu</p><h1>键盘样件</h1></div>
      <a class="mouse-study__link" href="/?monitors=study&mouse=study&keyboard=study">组合候选</a>
    </header>

    <div class="mouse-study__viewer">
      <div class="mouse-study__canvas" data-keyboard-canvas aria-label="拖动旋转键盘样件，滚轮缩放"></div>
      <div class="mouse-study__loading" data-keyboard-loading><span></span><p>正在准备键盘</p></div>
      <div class="mouse-study__error" data-keyboard-error hidden role="status">
        <h2>三维预览未能启动</h2>
        <p data-keyboard-error-message>键盘模型还在生成中，或当前浏览器未能启动 WebGL。</p>
      </div>
    </div>

    <aside class="mouse-study__panel" aria-label="键盘样件控制台">
      <section class="mouse-study__controls" aria-label="视角">
        <p class="mouse-study__label">视角</p>
        <div class="mouse-study__button-row">
          <button type="button" data-camera-preset="angled">斜侧</button>
          <button type="button" data-camera-preset="top">俯视</button>
          <button type="button" data-camera-preset="front">前沿</button>
          <button type="button" data-camera-preset="side">侧面</button>
        </div>
        <p class="mouse-study__note">拖动旋转，滚轮缩放。沿用现有键位与配色；隐藏结构为合理近似。</p>
      </section>

      <section class="mouse-study__controls" aria-label="显示模式">
        <p class="mouse-study__label">显示模式</p>
        <div class="mouse-study__segmented" role="group" aria-label="切换键盘材质或素模">
          <button type="button" data-shading-mode="material">材质</button>
          <button type="button" data-shading-mode="clay">素模</button>
        </div>
      </section>

      <section class="mouse-study__stats" aria-label="样件统计">
        <p class="mouse-study__label">结构统计</p>
        <dl>
          <div><dt>三角面</dt><dd data-stat="triangles">—</dd></div>
          <div><dt>结构材质</dt><dd data-stat="materials">—</dd></div>
          <div><dt>场景绘制调用</dt><dd data-stat="calls">—</dd></div>
        </dl>
        <p class="mouse-study__note">无新增模型下载。统计来自几何样件场景；静止时按需渲染。</p>
      </section>

      <p class="mouse-study__note" data-keyboard-status role="status">不编造品牌型号；仅检查本地样件。</p>
    </aside>
  </section>

  <style>
    .keyboard-study { height: 100vh; min-height: 760px; }
    .keyboard-study .mouse-study__viewer { min-height: 0; }
  </style>

  <script>
    import { mountKeyboardStudy } from "../desktop/studies/keyboard-study";

    const root = document.querySelector<HTMLElement>("[data-keyboard-study-root]");
    const dispose = root ? mountKeyboardStudy(root) : undefined;
    const cleanup = () => {
      window.removeEventListener("pagehide", cleanup);
      dispose?.();
    };
    window.addEventListener("pagehide", cleanup, { once: true });
    import.meta.hot?.dispose(cleanup);
  </script>
</SiteLayout>
