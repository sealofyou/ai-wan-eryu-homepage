---
import SiteHeader from "../components/SiteHeader.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  theme?: "system" | "soft";
  image?: string;
  immersive?: boolean;
}

const {
  title,
  description,
  theme = "system",
  image = "/og-cover.jpg",
  immersive = false,
} = Astro.props;

const pageTitle = title === "AI玩尔玉" ? "AI玩尔玉 | Eryu" : `${title} | AI玩尔玉`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const socialImage = Astro.site ? new URL(image, Astro.site) : image;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={theme === "soft" ? "#fffdf8" : "#f4f1ea"} />
    <link rel="icon" href="/brand/eryu-e-icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/brand/eryu-e-icon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/brand/eryu-e-icon-180.png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="AI玩尔玉" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body class:list={[`theme-${theme}`, { "is-immersive": immersive }]}>
    <a class="skip-link" href="#main-content">跳到正文</a>
    {!immersive && <SiteHeader />}
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
